---
import BaseLayout from '../layouts/BaseLayout.astro';

const baseUrl = import.meta.env.BASE_URL;
const zennUrl = 'https://zenn.dev/takenori_kusaka/books/sovereign-resilience-blueprint';
const publishingHubUrl = 'https://github.com/Takenori-Kusaka/publishing-hub';

const capabilities = [
  {
    t: '技術の横断設計',
    d: 'メカ設計・エレキ・組込みソフトからクラウド、生成AIまでを一貫して扱い、層をまたぐ問題を切り分ける。'
  },
  {
    t: 'クラウド基盤の標準化',
    d: 'IaCの全社標準、複数アカウント横断のガバナンス、オンプレからクラウドへの移行を設計・主導。'
  },
  {
    t: '生成AIの業務実装',
    d: 'PoCから社内展開までを担当。グループ全体の活用推進、社内DXコンサルティング10件以上。'
  },
  {
    t: '現場と経営の翻訳',
    d: '現場の課題を、選択肢・コストの桁・影響範囲として提示し、意思決定を前進させる。'
  }
];

const channels = [
  {
    t: 'Publishing Hub',
    d: '気になること、まとめ、技術メモの発信先。',
    href: publishingHubUrl,
    ext: true
  },
  {
    t: 'Zenn',
    d: '『未来予測の設計図』ほか、公開した書籍と記事。',
    href: zennUrl,
    ext: true
  },
  {
    t: 'GitHub',
    d: '実装と設計資産。',
    href: 'https://github.com/Takenori-Kusaka',
    ext: true
  },
  {
    t: 'LinkedIn',
    d: '職務経歴と専門家ネットワーク。',
    href: 'https://www.linkedin.com/in/%E6%AD%A6%E7%B4%80-%E6%97%A5%E4%B8%8B-17947820a/',
    ext: true
  },
  {
    t: 'YouTube',
    d: '技術解説。',
    href: 'https://www.youtube.com/channel/UCD1zo-WnyFdE5w0pqvKblkA',
    ext: true
  },
  {
    t: 'Podcast',
    d: 'recalog。',
    href: 'https://listen.style/p/recalog',
    ext: true
  },
  {
    t: '職務経歴書',
    d: '経歴と実績の詳細。PDFでも取得できます。',
    href: `${baseUrl}/resume/`,
    ext: false
  }
];
---

<BaseLayout
  title="ホーム"
  description="日下武紀の公開プロフィール。現場と経営のあいだを翻訳し、業務の認知的な負担を下げる設計に取り組む。"
>
  <article class="gw">
    <header class="gw-hero">
      <p class="gw-eyebrow">Takenori Kusaka ／ IoT・クラウド・生成AI</p>
      <h1 class="gw-title">
        現場と経営のあいだを翻訳し、<br />
        業務の認知的な負担を下げる設計をつくる。
      </h1>
      <p class="gw-lead">
        製造業の現場からクラウド、生成AIまでを横断して15年。
        利用者に手順を意識させずに、業務データの整形と判断支援を完了させる設計を専門としています。
      </p>
      <nav class="gw-links">
        <a href={`${baseUrl}/career/`}>キャリアビジョン</a>
        <a href={`${baseUrl}/resume/`}>職務経歴書</a>
        <a href={`${baseUrl}/about/`}>About</a>
      </nav>
    </header>

    <section class="gw-sec">
      <h2>できること</h2>
      <div class="gw-grid">
        {capabilities.map((c) => (
          <div class="gw-card">
            <h3>{c.t}</h3>
            <p>{c.d}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="gw-sec">
      <h2>発信と入口</h2>
      <p class="gw-note">
        気になることやまとめは Publishing Hub と Zenn で公開しています。このサイトはプロフィールと、そこへの入口です。
      </p>
      <ul class="gw-channels">
        {channels.map((ch) => (
          <li>
            {ch.ext ? (
              <a href={ch.href} target="_blank" rel="noopener noreferrer">
                <span class="gw-ch-t">{ch.t}</span>
                <span class="gw-ch-d">{ch.d}</span>
              </a>
            ) : (
              <a href={ch.href}>
                <span class="gw-ch-t">{ch.t}</span>
                <span class="gw-ch-d">{ch.d}</span>
              </a>
            )}
          </li>
        ))}
      </ul>
    </section>
  </article>
</BaseLayout>

<style>
  .gw {
    --ink: #1f2937;
    --slate: #6b7280;
    --line: #e3ddd1;
    --blue: #24548c;
    --green: #3a7d5c;
  }

  .gw-hero {
    padding: 0 0 2.5rem;
    border-bottom: 1px solid var(--line);
    margin-bottom: 3rem;
  }
  .gw-eyebrow {
    font-size: 0.74rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--slate);
    margin-bottom: 1rem;
  }
  .gw-title {
    font-size: 1.85rem;
    line-height: 1.5;
    font-weight: 700;
    color: var(--ink);
    margin-bottom: 1.25rem;
    letter-spacing: 0.01em;
  }
  .gw-lead {
    font-size: 1rem;
    line-height: 2;
    color: #374151;
    max-width: 42rem;
  }
  .gw-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 1.5rem;
    margin-top: 1.5rem;
    font-size: 0.85rem;
  }
  .gw-links a {
    color: var(--blue);
    text-decoration: none;
    border-bottom: 1px solid rgba(36, 84, 140, 0.3);
    padding-bottom: 1px;
  }
  .gw-links a:hover {
    border-bottom-color: var(--blue);
  }

  .gw-sec {
    margin-bottom: 3.2rem;
  }
  .gw-sec h2 {
    font-size: 1.1rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--ink);
    border-bottom: 2px solid var(--ink);
    display: inline-block;
    padding-bottom: 0.5rem;
    margin-bottom: 1.25rem;
  }
  .gw-note {
    font-size: 0.88rem;
    line-height: 1.8;
    color: var(--slate);
    margin: -0.4rem 0 1.2rem;
    max-width: 42rem;
  }

  .gw-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
  }
  .gw-card {
    border: 1px solid var(--line);
    border-top: 2px solid var(--blue);
    background: #fff;
    padding: 1.1rem 1.2rem;
  }
  .gw-card h3 {
    font-size: 0.95rem;
    font-weight: 700;
    margin: 0 0 0.5rem;
    color: var(--ink);
  }
  .gw-card p {
    font-size: 0.85rem;
    line-height: 1.8;
    color: #374151;
    margin: 0;
  }

  .gw-channels {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line);
  }
  .gw-channels li {
    border-bottom: 1px solid var(--line);
  }
  .gw-channels a {
    display: grid;
    grid-template-columns: 10rem 1fr;
    gap: 1rem;
    padding: 0.9rem 0;
    text-decoration: none;
  }
  .gw-ch-t {
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--ink);
  }
  .gw-ch-d {
    font-size: 0.88rem;
    line-height: 1.7;
    color: #374151;
  }
  .gw-channels a:hover .gw-ch-t {
    color: var(--blue);
  }

  @media (max-width: 720px) {
    .gw-grid {
      grid-template-columns: 1fr;
    }
    .gw-title {
      font-size: 1.45rem;
    }
    .gw-channels a {
      grid-template-columns: 1fr;
      gap: 0.2rem;
    }
  }
</style>
