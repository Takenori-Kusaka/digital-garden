---
import BaseLayout from '../../layouts/BaseLayout.astro';

const baseUrl = import.meta.env.BASE_URL;
const zennUrl = 'https://zenn.dev/takenori_kusaka/books/sovereign-resilience-blueprint';

const scenarios = [
  {
    id: 'A', name: '延長・深化', sub: '現場実装のアーキテクト',
    scores: ['高', '高', '中', '中', '中', '中'],
    role: '現在の専門性を、組織横断の設計責任へ広げる',
    body: '製造業の現場接点を持つ環境で、生成AIを組み込んだ業務プロセスと共通アセットを設計する。'
  },
  {
    id: 'B', name: '意欲・転換', sub: '公共・コモンズの設計者',
    scores: ['非常に高い', '中', '高', '高', '高', '高'],
    role: '行政・公共・産業の意思決定基盤へ領域を広げる',
    body: 'データコモンズ、行政プロセス、社会インフラの継続性を支える技術と運用を実装する。'
  },
  {
    id: 'C', name: '制約解除', sub: '独立した技術パートナー',
    scores: ['高', '中', '中', '高', '非常に高い', '高'],
    role: '所属に依存しないアセットと支援モデルをつくる',
    body: '再利用可能なソフトウェア、設計原則、伴走支援を組み合わせ、複数の組織・現場へ価値を届ける。'
  }
];

const horizons = [
  {
    t: '2029', age: '38歳', label: '3年後', rows: [
      ['Being', '技術の実装力と業務理解を兼ね備え、現場の課題を構造化して意思決定へつなげる実務者。'],
      ['Role', '現場と経営のあいだを翻訳するアーキテクト。業務プロセスと共通アセットの設計責任を担う。'],
      ['Impact', '利用者の作業動線を変えずに、情報整理・エスカレーション・判断支援の費用を下げる。'],
      ['Domain', '製造業、設備、業務プロセス、生成AI、クラウド基盤。'],
      ['Capability', '複数の技術層を横断した設計、トレードオフの可視化、関係者間の合意形成。'],
      ['Evidence', '本番運用された業務アセット、設計記録、導入効果、再利用可能なドキュメント。'],
      ['Environment', '現場との接点を持ち、設計意図と運用結果を往復できるチーム。'],
      ['Life', '長期的に成果を出せる働き方と、継続的な学習・発信の時間を確保する。']
    ]
  },
  {
    t: '2031', age: '40歳', label: '5年後', rows: [
      ['Being', '特定の製品や技術ではなく、現場・事業・技術を接続する能力で選ばれる専門家。'],
      ['Role', '複数職能にまたがる意思決定を、選択肢・コスト・影響範囲の可視化によって前進させる。'],
      ['Impact', '現場への導入負担を抑えたデータ化と判断支援を、複数の業務領域で再現する。'],
      ['Domain', '環境知能、プロセス設計、データコモンズ、公共・産業のガバナンス。'],
      ['Capability', '顧客課題の発見、事業価値の定義、技術投資の説明、実装から計測までの一貫運用。'],
      ['Evidence', '複数のケーススタディ、公開設計原則、他者に引き継がれたアセット、紹介・相談。'],
      ['Environment', '組織内外の専門家と協働し、所属を越えて知見と成果を循環させる環境。'],
      ['Life', '専門性の深化と、持続的に価値を提供できる働き方を両立する。']
    ]
  },
  {
    t: '2036', age: '45歳', label: '10年後', rows: [
      ['Being', '事業と技術を橋渡しし、変化の大きい環境でも継続性のある仕組みを設計できる社会アーキテクト。'],
      ['Role', '一事業または複数チームの中長期の技術・プロセス戦略に責任を持つ。'],
      ['Impact', '組織や地域が、外部サービスに依存しきらずに判断と業務を継続できる設計を残す。'],
      ['Domain', '情報主権、Local-First、エッジAI、通信・データ基盤、地域・産業システム。'],
      ['Capability', '設備・構成・制度の3つの水準を同時に設計し、人材育成まで含めて定着させる。'],
      ['Evidence', '組織・地域に定着した運用プロトコル、育成された人材、継続利用される設計資産。'],
      ['Environment', '組織・地域・専門コミュニティを横断する、実装と知識循環のネットワーク。'],
      ['Life', 'テーマと働き方を主体的に選び、長期的な社会実装に関わる。']
    ]
  },
  {
    t: '2046', age: '55歳', label: '20年後', rows: [
      ['Being', '人と組織の判断・創造性を拡張する仕組みを生み、次の世代へ渡す設計者。'],
      ['Role', 'コモンズの設計思想家・技術指導者。'],
      ['Impact', '供給の継続性と決定の根拠を、現場で運用可能な設計へ落とし込む。'],
      ['Domain', '情報・通信・水・電力など、生活を支える基盤の局所協調。'],
      ['Capability', '技術、制度、組織文化を一つの設計体系として説明し、後進へ移転する。'],
      ['Evidence', '属人性を排した設計書、OSS、運用プロトコル、継続して使われる教育資産。'],
      ['Environment', '地域に根ざしながら、専門知を広く共有する活動形態。'],
      ['Life', '学び・創造・文化形成を続けながら、次の担い手が自律できる状態をつくる。']
    ]
  }
];

const canvas = [
  ['Customers / 顧客', '現場の利用者、業務責任者、事業責任者、公共・産業の意思決定者'],
  ['Value Provided / 提供価値', '利用者の導入負担を抑えた業務データ化、判断支援、トレードオフの可視化'],
  ['Channels / 経路', '本番実績、ケーススタディ、設計ドキュメント、公開記事、紹介、プロトタイプ'],
  ['Relationships / 関係', '組織横断の協働、プロジェクト、技術顧問、専門家コミュニティ'],
  ['Revenue & Benefits / 対価', '給与・報酬、裁量、専門性、信用、継続的な社会的インパクト'],
  ['Key Resources / 主要資産', 'IoT・組込み・クラウド・生成AIの統合経験、設計原則、公開実績、共通アセット'],
  ['Key Activities / 主要活動', '課題発見、アーキテクチャ設計、実装、評価、合意形成、ドキュメンテーション、人材育成'],
  ['Key Partners / 主要パートナー', '現場の熟達者、プロダクト・デザイン・営業、公共側の実践者、技術専門家'],
  ['Costs / コスト', '導入・運用・保守の負担、意思決定の遅延、技術負債、知識移転の費用']
];

const gaps = [
  ['G1', '組織横断の意思決定', '技術・事業・現場の選択肢を揃え、責任ある決定を支援する', 'トレードオフの可視化と提案の反復', '高'],
  ['G2', '顧客課題の直接検証', '利用者の行動と業務結果から価値を検証する', '二次情報から一次の現場接点へ広げる', '高'],
  ['G3', '専門家ネットワーク', '自分が直接扱っていない領域の妥当性を、1分野に1名の相談相手と確かめる', '最初の1分野は組織設計・移管。相手は他社の同格の技術者や先達。判断に迷っている設計を公開し、反応した人と一対一で議論する', '中'],
  ['G4', '事業価値の説明', '技術の効果を、事業責任者が投資判断に使える言葉へ置き換えて届ける', '効果の桁は示せている。次は、その桁が事業上の何を意味するかを相手の言葉で説明する', '高']
];

const experiments = [
  ['課題', '会議・業務ログから判断事項を構造化し、意思決定の遅延と見落としを減らす'],
  ['仮説', '情報整理を仕組み化することで、担当者の認知的な負荷を下げ、重要な判断に集中できる'],
  ['実施', '小さな業務範囲で抽出・確認・共有の流れを試し、利用者の反応と運用上の障壁を記録する'],
  ['成果物', '運用フロー、設計記録、評価指標、改善案、再利用可能なテンプレート'],
  ['成功条件', '実務で継続利用され、意思決定の前提が共有される。効果と限界を説明できる'],
  ['判定', '継続・拡大・別領域への展開・中止を、利用結果と関係者の判断で決める']
];
---

<BaseLayout
  title="キャリア開発計画"
  description="日下武紀の公開キャリア開発計画。BMY×IDPを統合したCMDSで、専門性・価値提供・将来の役割・開発課題を整理する。"
>
  <article class="system">
    <header class="system-hero">
      <p class="system-back"><a href={`${baseUrl}/career/`}>← キャリアビジョンへ戻る</a></p>
      <p class="system-eyebrow">Career Development Plan ／ CMDS v0.3</p>
      <h1>キャリア開発計画</h1>
      <p class="system-lead">
        Business Model You の価値提供モデルと、Individual Development Plan の開発・レビューを統合した公開版です。
        採用・協働・社内配置の検討に使えるよう、専門性、提供価値、将来の役割、開発テーマを整理しています。
      </p>
      <p class="system-note">
        本計画は固定的な職位計画ではありません。技術、市場、社会環境の変化を踏まえ、年次で更新します。
        世界認識の背景は <a href={zennUrl} target="_blank" rel="noopener noreferrer">公開書籍</a> にまとめています。
      </p>
    </header>

    <nav class="system-toc" aria-label="構成">
      <a href="#purpose">Purpose</a><a href="#scenarios">Scenarios</a><a href="#horizons">Time Horizons</a>
      <a href="#canvas">Career Model</a><a href="#profile">Target Profile</a><a href="#gaps">Development Gaps</a>
      <a href="#experiments">Experiments</a><a href="#review">Review</a>
    </nav>

    <section id="purpose" class="system-section">
      <h2><span>M1</span> Purpose &amp; Constraints</h2>
      <p class="system-p">
        現場の利用者が新しい操作を覚えなくても業務を続けられるよう、IoT、クラウド、生成AIを組み合わせて業務プロセスを設計する。
        現場・事業・技術のトレードオフを可視化し、判断の前提と責任の所在が共有される状態をつくる。
      </p>
      <div class="purpose-grid">
        <div><h3>提供する専門性</h3><p>物理デバイスからクラウド、生成AIまでを接続する統合設計。実装・運用・引き継ぎまでを含む。</p></div>
        <div><h3>重視する価値</h3><p>根拠の開示、利用者の受容力からの設計、持続可能な運用、知識の資産化。</p></div>
        <div><h3>活躍しやすい環境</h3><p>現場と意思決定者の距離が近く、設計意図と運用結果を往復できる組織。</p></div>
        <div><h3>避ける環境</h3><p>単一技術の反復だけで量を競う環境、判断の前提が共有されない環境、研究開発だけが目的の役割。</p></div>
      </div>
    </section>

    <section id="scenarios" class="system-section">
      <h2><span>M2</span> Future Scenarios</h2>
      <p class="system-p">
        役割の選択肢を単線化せず、現在の専門性を深める道、公共・産業へ広げる道、所属を越えて提供する道を並列に持つ。
        現時点ではAを基線とし、BとCに有効な資産を同時に蓄積する。基線は固定せず、下記の前提を定期的に点検する。
      </p>
      <div class="scenario-grid">
        {scenarios.map((s) => (
          <article class="scenario-card">
            <p class="scenario-id">{s.id}</p>
            <h3>{s.name}</h3>
            <p class="scenario-sub">{s.sub}</p>
            <p class="scenario-role">{s.role}</p>
            <p>{s.body}</p>
          </article>
        ))}
      </div>
      <div class="table-wrap">
        <table class="public-table score-table">
          <thead><tr><th>評価軸</th><th>A</th><th>B</th><th>C</th><th>読み方</th></tr></thead>
          <tbody>
            <tr><th>本人の関心</th><td>高</td><td class="strong">非常に高い</td><td>高</td><td>長期的なテーマとの一致</td></tr>
            <tr><th>現在からの接続</th><td class="strong">高</td><td>中</td><td>中</td><td>既存経験からの移行可能性</td></tr>
            <tr><th>社会的需要</th><td>中</td><td class="strong">高</td><td>中</td><td>継続的に解く価値がある課題か</td></tr>
            <tr><th>選択肢の拡大</th><td>中</td><td>高</td><td class="strong">非常に高い</td><td>他の役割にも効く資産か</td></tr>
            <tr><th>現時点の位置づけ</th><td class="strong">基線</td><td>展開先</td><td>長期オプション</td><td>固定的な決定ではない</td></tr>
          </tbody>
        </table>
      </div>

      <h3>基線を支える前提と、見直す条件</h3>
      <p class="system-p">
        評価の点数だけでは、どの前提が変わると結論が動くのかが分からない。
        アーキテクチャ評価手法（ATAM）にならい、結論が敏感に反応する前提と、両立しない要素を明示する。
      </p>
      <div class="table-wrap">
        <table class="public-table">
          <thead><tr><th>区分</th><th>内容</th><th>点検の観点</th></tr></thead>
          <tbody>
            <tr><th>前提 1</th><td>設計と意思決定に関与できる</td><td>設計・判断に充てる時間が、調整と代替作業に置き換わっていないか</td></tr>
            <tr><th>前提 2</th><td>設計の妥当性を相互に確認できる</td><td>自分が直接扱っていない領域を確かめられる技術者が身近にいるか</td></tr>
            <tr><th>前提 3</th><td>持続可能な進め方を維持できる</td><td>資源の不足が、個人の作業量ではなく優先度の判断として扱われているか</td></tr>
            <tr><th>両立しない要素</th><td>目先の要望への即応 ／ 長く使える設計</td><td>資源が足りないとき、範囲と期日のどちらを動かすかを関係者と決められているか</td></tr>
          </tbody>
        </table>
      </div>
      <p class="system-muted">
        前提のいずれかが成り立たなくなった場合は、年次の見直しを待たずにシナリオの位置づけを再評価する。
        判断は「状況・決定・採らなかった選択肢・帰結」の形式で記録している。
      </p>
    </section>

    <section id="horizons" class="system-section">
      <h2>時間軸（8項目）</h2>
      <p class="system-muted">役職名ではなく、担う問題・責任・専門性・証拠・環境で将来を記述する。</p>
      {horizons.map((h) => (
        <div class="horizon">
          <div class="horizon-head"><span class="horizon-year">{h.t}</span><span>{h.age} ／ {h.label}</span></div>
          <dl>
            {h.rows.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}
          </dl>
        </div>
      ))}
    </section>

    <section id="canvas" class="system-section">
      <h2><span>M3</span> Personal Career Model Canvas</h2>
      <p class="system-p">誰に、どのような価値を、どの経路で届け、どの資産と関係を得るかを9ブロックで整理する。</p>
      <div class="canvas-grid">
        {canvas.map(([title, body]) => <div class="canvas-block"><h3>{title}</h3><p>{body}</p></div>)}
      </div>
    </section>

    <section id="profile" class="system-section">
      <h2><span>M4</span> Target Profile &amp; Evidence</h2>
      <p class="system-muted">5年後を主な開発対象とし、学習ではなく実務の証拠で到達を確認する。</p>
      <div class="table-wrap">
        <table class="public-table profile-table">
          <thead><tr><th>領域</th><th>目標状態</th><th>証拠</th></tr></thead>
          <tbody>
            <tr><th>専門性</th><td>現場の導入負担を抑えたデータ整形と判断支援を本番に載せる</td><td>導入実績、ADR、稼働ログ</td></tr>
            <tr><th>プロダクト</th><td>機能ではなく業務上の成果と負担軽減で価値を定義する</td><td>採択実績、利用者の声、改善結果</td></tr>
            <tr><th>リーダーシップ</th><td>選択肢と影響範囲を示し、複数職能の意思決定を前進させる</td><td>提案資料、意思決定記録、チーム成果</td></tr>
            <tr><th>事業・経済性</th><td>技術投資を費用・継続性・成果の桁で説明する</td><td>効果試算、承認記録、継続利用</td></tr>
            <tr><th>信用・発信</th><td>現場×AIの設計について相談される</td><td>公開物、問い合わせ、紹介、対話</td></tr>
            <tr><th>知識移転</th><td>設計意図と運用方法を、他者が再利用できる形で残す</td><td>設計書、テンプレート、育成実績</td></tr>
          </tbody>
        </table>
      </div>
    </section>

    <section id="gaps" class="system-section">
      <h2><span>M5</span> Development Gaps</h2>
      <p class="system-muted">不足をすべて埋めるのではなく、複数の将来に効く高レバレッジの課題から着手する。</p>
      <div class="table-wrap">
        <table class="public-table gap-table">
          <thead><tr><th>ID</th><th>開発テーマ</th><th>目標</th><th>現在の焦点</th><th>優先度</th></tr></thead>
          <tbody>
            {gaps.map((g) => <tr><th>{g[0]}</th><td>{g[1]}</td><td>{g[2]}</td><td>{g[3]}</td><td>{g[4]}</td></tr>)}
          </tbody>
        </table>
      </div>
      <div class="adaptation">
        <h3>市場変化への適応</h3>
        <p>
          生成AIの利用が一般化した場合は、画面上の機能開発だけを競争軸にしない。
          現場の物理環境、エッジでの処理、業務制度の設計を組み合わせる領域へ、専門性の重心を移す。
        </p>
      </div>
    </section>

    <section id="experiments" class="system-section">
      <h2><span>M6</span> Development Experiments</h2>
      <p class="system-p">大きなキャリア変更の前に、小さな業務実験で役割適合性と成果を検証する。</p>
      <dl class="experiment">
        {experiments.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}
      </dl>
    </section>

    <section id="review" class="system-section">
      <h2><span>M7</span> Review &amp; Reconfiguration</h2>
      <div class="review-grid">
        <div><h3>四半期</h3><p>実験の結果、利用者の反応、成果物、次に取るべき選択を確認する。</p></div>
        <div><h3>半期</h3><p>開発テーマの優先順位と、12か月の実行計画を見直す。</p></div>
        <div><h3>年次</h3><p>Purpose、シナリオ、価値提供モデル、目標プロフィールを更新する。</p></div>
      </div>
      <p class="system-p">判断材料は、成果物、利用結果、市場・組織の反応、外部環境の変化。計画は固定せず、証拠に応じて再構成する。</p>
    </section>

    <footer class="system-foot">
