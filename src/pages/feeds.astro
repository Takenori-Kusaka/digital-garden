---
import BaseLayout from '../layouts/BaseLayout.astro';
import feedsData from '../data/feeds.json';

const baseUrl = import.meta.env.BASE_URL;

// Calculate total feeds count
const totalFeeds = feedsData.reduce((acc, cat) => acc + cat.feeds.length, 0);
---

<BaseLayout
  title="アンテナ (RSS Subscriptions)"
  description="日下武紀が日々の情報収集・技術動向のキャッチアップのために購読しているRSSフィード（アンテナ）の一覧です。"
>
  <div class="max-w-6xl mx-auto">
    <!-- Header Hero Banner -->
    <section class="bg-gradient-to-r from-teal-50 to-emerald-50 rounded-2xl p-8 md:p-12 mb-12 shadow-sm border border-emerald-100">
      <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-6">
        <div>
          <span class="inline-block px-3 py-1 bg-emerald-100 text-emerald-800 rounded-full text-xs font-semibold mb-3">
            📡 ANTENNA & FEEDS
          </span>
          <h1 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">
            購読RSSフィード一覧 (アンテナ)
          </h1>
          <p class="text-gray-700 leading-relaxed max-w-2xl">
            日下武紀の知識のインプット（アンテナ）として機能しているRSSフィードの一覧です。
            「Calm Technology」の思想に基づき、通知に頼らず周辺視野で情報環境を捉え、
            必要な時にアクセスする自律的な情報収集（デジタル官僚主義のインプット層）を実践しています。
          </p>
        </div>
        <div class="flex flex-col sm:flex-row gap-4 w-full md:w-auto">
          <a
            href={`${baseUrl}/feeds.opml`}
            download
            class="flex items-center justify-center gap-2 px-5 py-3 bg-emerald-600 text-white font-medium rounded-lg hover:bg-emerald-700 transition shadow-sm no-underline"
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/>
            </svg>
            <span>OPMLをダウンロード</span>
          </a>
        </div>
      </div>

      <!-- Stats Bar -->
      <div class="grid grid-cols-2 sm:grid-cols-3 gap-4 mt-8 pt-8 border-t border-emerald-200 border-opacity-60 text-sm text-gray-600">
        <div>
          <span class="block text-2xl font-bold text-emerald-700">{totalFeeds}</span>
          <span>総購読フィード数</span>
        </div>
        <div>
          <span class="block text-2xl font-bold text-emerald-700">{feedsData.length}</span>
          <span>カテゴリ数</span>
        </div>
        <div>
          <span class="block text-2xl font-bold text-emerald-700">Feedly</span>
          <span>管理ソース</span>
        </div>
      </div>
    </section>

    <!-- Search and Filter Bar -->
    <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-6 mb-8 flex flex-col md:flex-row gap-4 justify-between items-center sticky top-20 z-40 bg-opacity-95 backdrop-blur-md">
      <div class="relative w-full md:max-w-md">
        <span class="absolute inset-y-0 left-0 flex items-center pl-3 pointer-events-none text-gray-400">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
          </svg>
        </span>
        <input
          type="text"
          id="search-input"
          placeholder="フィード名やURLで検索..."
          class="w-full pl-10 pr-4 py-2 border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 text-sm"
        />
      </div>

      <div class="flex gap-2 flex-wrap w-full md:w-auto justify-end">
        <button
          class="category-btn px-4 py-1.5 rounded-full text-sm font-medium bg-emerald-500 text-white border border-emerald-500 transition"
          data-category="all"
        >
          すべて ({totalFeeds})
        </button>
        {feedsData.map((cat) => (
          <button
            class="category-btn px-4 py-1.5 rounded-full text-sm font-medium bg-gray-100 text-gray-700 border border-gray-100 hover:bg-gray-200 transition"
            data-category={cat.category}
          >
            {cat.category} ({cat.feeds.length})
          </button>
        ))}
      </div>
    </div>

    <!-- Feeds Grid Section -->
    <div id="feeds-container" class="space-y-12">
      {feedsData.map((cat) => (
        <div class="category-section" data-category={cat.category}>
          <h2 class="text-2xl font-bold text-gray-800 mb-6 flex items-center gap-2 border-b pb-2">
            <span class="text-xl">📁</span>
            <span>{cat.category}</span>
          </h2>

          <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
            {cat.feeds.map((feed) => (
              <div class="feed-card bg-white rounded-xl shadow-sm border border-gray-100 p-6 hover:shadow-md hover:border-emerald-200 transition duration-200 flex flex-col justify-between">
                <div>
                  <h3 class="font-bold text-gray-900 mb-2 line-clamp-2 feed-title" title={feed.title}>
                    {feed.title}
                  </h3>
                  {feed.text && feed.text !== feed.title && (
                    <p class="text-xs text-gray-500 mb-4 line-clamp-1">
                      {feed.text}
                    </p>
                  )}
                </div>

                <div class="flex items-center justify-between mt-4 pt-4 border-t border-gray-50 text-sm">
                  {/* Website Link */}
                  {feed.htmlUrl ? (
                    <a
                      href={feed.htmlUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="flex items-center gap-1.5 text-blue-600 hover:text-blue-700 font-medium no-underline feed-link"
                    >
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
                      </svg>
                      <span>Webサイト</span>
                    </a>
                  ) : (
                    <span class="text-gray-400">Webなし</span>
                  )}

                  {/* RSS Link */}
                  {feed.xmlUrl ? (
                    <a
                      href={feed.xmlUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="flex items-center gap-1 text-orange-500 hover:text-orange-600 font-medium no-underline feed-rss"
                    >
                      <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                        <path d="M5.922 21a2.922 2.922 0 1 1 0-5.844A2.922 2.922 0 0 1 5.922 21zm-4.331-.027c-.035-5.32 3.99-9.742 9.297-9.845 5.378-.103 9.8 4.195 9.8 9.57a.3.3 0 0 1-.3.3H16.89a.3.3 0 0 1-.3-.273c-.222-3.125-2.695-5.63-5.842-5.814a.3.3 0 0 1-.273-.3v-3.5a.3.3 0 0 1 .3-.3c8.983-.027 16.326 7.158 16.326 16.155a.3.3 0 0 1-.3.3H21.5a.3.3 0 0 1-.3-.273 12.39 12.39 0 0 0-11.83-11.83.3.3 0 0 1-.27-.3v-3.5a.3.3 0 0 1 .3-.3c5.385.034 9.774 4.343 9.878 9.728a.3.3 0 0 1-.3.3H1.89a.3.3 0 0 1-.3-.273z"/>
                      </svg>
                      <span>RSSフィード</span>
                    </a>
                  ) : (
                    <span class="text-gray-400">RSSなし</span>
                  )}
                </div>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>

    <!-- Empty State for Search -->
    <div id="empty-state" class="hidden text-center py-16">
      <div class="text-5xl mb-4">🔍</div>
      <h3 class="text-xl font-bold text-gray-800 mb-2">フィードが見つかりません</h3>
      <p class="text-gray-600">検索ワードやカテゴリを変更してお試しください。</p>
    </div>

    <!-- Footer Guide Box -->
    <section class="mt-16 bg-gray-50 border border-gray-100 rounded-xl p-8">
      <h3 class="text-xl font-bold text-gray-800 mb-4 flex items-center gap-2">
        <span>🌱</span>
        <span>このアンテナ（フィード）について</span>
      </h3>
      <p class="text-gray-700 leading-relaxed mb-4">
        このページに掲載されているフィードは、日下武紀がFeedlyクラウド上で整理している情報源の一部です。
        最新技術（AI、IoT、クラウド）、学術論文、業界動向など多岐にわたる信頼性の高いメディアが含まれています。
      </p>
      <p class="text-gray-700 leading-relaxed">
        <strong>周辺視野としての活用:</strong> 
        アンビエント（環境的）情報としてのRSS購読は、「注意をハイジャックしない」情報収集スタイルを実現します。
        このリストをダウンロード（OPML）し、ご自身のRSSリーダー（NetNewsWire, Feedly, Reeder等）にインポートして活用していただくことも可能です。
      </p>
    </section>
  </div>
</BaseLayout>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const searchInput = document.getElementById('search-input');
    const categoryBtns = document.querySelectorAll('.category-btn');
    const feedCards = document.querySelectorAll('.feed-card');
    const categorySections = document.querySelectorAll('.category-section');
    const emptyState = document.getElementById('empty-state');

    let activeCategory = 'all';
    let searchQuery = '';

    function filterFeeds() {
      let visibleFeedsCount = 0;

      categorySections.forEach(section => {
        const sectionCategory = section.getAttribute('data-category');
        const cardsInSection = section.querySelectorAll('.feed-card');
        let visibleCardsInSectionCount = 0;

        cardsInSection.forEach(card => {
          const title = card.querySelector('.feed-title').textContent.toLowerCase();
          const links = Array.from(card.querySelectorAll('a')).map(a => a.href.toLowerCase()).join(' ');
          const textElement = card.querySelector('p');
          const description = textElement ? textElement.textContent.toLowerCase() : '';

          const matchesSearch = title.includes(searchQuery) || description.includes(searchQuery) || links.includes(searchQuery);
          const matchesCategory = activeCategory === 'all' || sectionCategory === activeCategory;

          if (matchesSearch && matchesCategory) {
            card.style.display = 'flex';
            visibleCardsInSectionCount++;
            visibleFeedsCount++;
          } else {
            card.style.display = 'none';
          }
        });

        // Hide section entirely if it has no matching cards
        if (visibleCardsInSectionCount > 0) {
          section.style.display = 'block';
        } else {
          section.style.display = 'none';
        }
      });

      // Show/hide empty state
      if (visibleFeedsCount === 0) {
        emptyState.classList.remove('hidden');
      } else {
        emptyState.classList.add('hidden');
      }
    }

    // Search Input Event
    if (searchInput) {
      searchInput.addEventListener('input', (e) => {
        searchQuery = e.target.value.toLowerCase().trim();
        filterFeeds();
      });
    }

    // Category Button Click Events
    categoryBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        // Toggle active button style
        categoryBtns.forEach(b => {
          b.classList.remove('bg-emerald-500', 'text-white', 'border-emerald-500');
          b.classList.add('bg-gray-100', 'text-gray-700', 'border-gray-100');
        });

        btn.classList.remove('bg-gray-100', 'text-gray-700', 'border-gray-100');
        btn.classList.add('bg-emerald-500', 'text-white', 'border-emerald-500');

        activeCategory = btn.getAttribute('data-category');
        filterFeeds();
      });
    });
  });
</script>
