---
import BaseLayout from '../layouts/BaseLayout.astro';
import feedsData from '../data/feeds.json';

const baseUrl = import.meta.env.BASE_URL;
const totalFeeds = feedsData.reduce((acc, cat) => acc + cat.feeds.length, 0);
---

<BaseLayout
  title="アンテナ"
  description="日下武紀が購読しているRSSフィード（アンテナ）の一覧。"
>
  <article class="fd">
    <header class="fd-hero">
      <p class="fd-eyebrow">Antenna ／ RSS Subscriptions</p>
      <h1 class="fd-title">購読している情報源</h1>
      <p class="fd-lead">
        通知に頼らず、周辺視野で情報環境を捉えるための購読リストです。
        必要なときにアクセスする、自律的な情報収集のインプット層として運用しています。
      </p>
      <nav class="fd-links">
        <a href={`${baseUrl}/feeds.opml`} download>OPMLをダウンロード</a>
      </nav>
      <dl class="fd-stats">
        <div>
          <dt>購読数</dt>
          <dd>{totalFeeds}</dd>
        </div>
        <div>
          <dt>カテゴリ</dt>
          <dd>{feedsData.length}</dd>
        </div>
        <div>
          <dt>管理</dt>
          <dd>Feedly</dd>
        </div>
      </dl>
    </header>

    <div class="fd-toolbar">
      <input
        type="text"
        id="search-input"
        placeholder="フィード名やURLで検索"
        class="fd-search"
      />
      <div class="fd-filters">
        <button class="category-btn is-active" data-category="all">
          すべて ({totalFeeds})
        </button>
        {feedsData.map((cat) => (
          <button class="category-btn" data-category={cat.category}>
            {cat.category} ({cat.feeds.length})
          </button>
        ))}
      </div>
    </div>

    <div id="feeds-container">
      {feedsData.map((cat) => (
        <section class="fd-sec category-section" data-category={cat.category}>
          <h2>{cat.category}</h2>
          <ul class="fd-list">
            {cat.feeds.map((feed) => (
              <li class="feed-card">
                <span class="feed-title">{feed.title}</span>
                {feed.text && feed.text !== feed.title && (
                  <span class="fd-sub">{feed.text}</span>
                )}
                <span class="fd-actions">
                  {feed.htmlUrl ? (
                    <a
                      href={feed.htmlUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="feed-link"
                    >
                      Web
                    </a>
                  ) : (
                    <span class="fd-muted">Webなし</span>
                  )}
                  {feed.xmlUrl ? (
                    <a
                      href={feed.xmlUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="feed-rss"
                    >
                      RSS
                    </a>
                  ) : (
                    <span class="fd-muted">RSSなし</span>
                  )}
                </span>
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>

    <div id="empty-state" class="fd-empty hidden">
      <p>該当するフィードはありません。検索語またはカテゴリを変えてください。</p>
    </div>

    <footer class="fd-foot">
      <p>
        Feedly 上で整理している情報源の一部です。OPML をダウンロードし、
        ご自身の RSS リーダーへ取り込むことができます。
      </p>
    </footer>
  </article>
</BaseLayout>

<style>
  .fd {
    --ink: var(--kb-color-text-primary);
    --slate: var(--kb-color-text-secondary);
    --line: var(--kb-color-border-line);
    --blue: var(--kb-color-text-link);
    --green: var(--kb-color-state-success);
  }

  .fd-hero {
    padding: 0 0 2.5rem;
    border-bottom: 1px solid var(--line);
    margin-bottom: 2rem;
  }
  .fd-eyebrow {
    font-size: 0.74rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--slate);
    margin-bottom: 1rem;
  }
  .fd-title {
    font-size: 1.85rem;
    line-height: 1.5;
    font-weight: 700;
    color: var(--ink);
    margin-bottom: 1.25rem;
    letter-spacing: 0.01em;
  }
  .fd-lead {
    font-size: 1rem;
    line-height: 2;
    color: var(--kb-color-ink-800);
    max-width: 42rem;
  }
  .fd-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 1.5rem;
    margin-top: 1.5rem;
    font-size: 0.85rem;
  }
  .fd-links a {
    color: var(--blue);
    text-decoration: none;
    border-bottom: 1px solid var(--kb-color-ai-300);
    padding-bottom: 1px;
  }
  .fd-links a:hover {
    border-bottom-color: var(--blue);
  }

  .fd-stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
    margin: 1.75rem 0 0;
    padding-top: 1.25rem;
    border-top: 1px solid var(--line);
  }
  .fd-stats div {
    margin: 0;
  }
  .fd-stats dt {
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    color: var(--slate);
    margin-bottom: 0.2rem;
  }
  .fd-stats dd {
    margin: 0;
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--ink);
  }

  .fd-toolbar {
    margin-bottom: 2.5rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--line);
  }
  .fd-search {
    width: 100%;
    max-width: 28rem;
    font-size: 0.88rem;
    padding: 0.55rem 0.75rem;
    border: 1px solid var(--line);
    background: var(--kb-color-surface-card);
    color: var(--ink);
    outline: none;
  }
  .fd-search:focus {
    border-color: var(--blue);
  }
  .fd-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 0.5rem;
    margin-top: 0.9rem;
  }
  .category-btn {
    font-size: 0.78rem;
    line-height: 1.4;
    padding: 0.25rem 0.55rem;
    border: 1px solid var(--line);
    background: var(--kb-color-surface-card);
    color: var(--slate);
    cursor: pointer;
  }
  .category-btn:hover {
    color: var(--ink);
    border-color: var(--ink);
  }
  .category-btn.is-active {
    color: #fff;
    background: var(--ink);
    border-color: var(--ink);
  }

  .fd-sec {
    margin-bottom: 2.6rem;
  }
  .fd-sec h2 {
    font-size: 1.05rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    color: var(--ink);
    border-bottom: 2px solid var(--ink);
    display: inline-block;
    padding-bottom: 0.45rem;
    margin-bottom: 0.9rem;
  }
  .fd-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line);
  }
  .feed-card {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 0.35rem 1.25rem;
    padding: 0.75rem 0;
    border-bottom: 1px solid var(--line);
  }
  .feed-title {
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--ink);
  }
  .fd-sub {
    grid-column: 1;
    font-size: 0.78rem;
    color: var(--slate);
  }
  .fd-actions {
    grid-column: 2;
    grid-row: 1 / span 2;
    display: flex;
    align-items: center;
    gap: 0.9rem;
    font-size: 0.78rem;
    white-space: nowrap;
  }
  .fd-actions a {
    color: var(--blue);
    text-decoration: none;
    border-bottom: 1px solid var(--kb-color-ai-300);
    padding-bottom: 1px;
  }
  .fd-actions a:hover {
    border-bottom-color: var(--blue);
  }
  .fd-muted {
    color: var(--slate);
  }

  .fd-empty {
    text-align: center;
    padding: 2.5rem 0;
    color: var(--slate);
    font-size: 0.9rem;
  }
  .hidden {
    display: none;
  }

  .fd-foot {
    margin-top: 2.5rem;
    padding-top: 1.75rem;
    border-top: 1px solid var(--line);
    font-size: 0.82rem;
    line-height: 1.9;
    color: var(--slate);
  }

  @media (max-width: 720px) {
    .fd-title {
      font-size: 1.45rem;
    }
    .fd-stats {
      grid-template-columns: 1fr;
    }
    .feed-card {
      grid-template-columns: 1fr;
    }
    .fd-actions {
      grid-column: 1;
      grid-row: auto;
    }
  }
</style>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const searchInput = document.getElementById('search-input');
    const categoryBtns = document.querySelectorAll('.category-btn');
    const feedCards = document.querySelectorAll('.feed-card');
    const categorySections = document.querySelectorAll('.category-section');
    const emptyState = document.getElementById('empty-state');

    let activeCategory = 'all';
    let searchQuery = '';

    function filterFeeds() {
      let visibleFeedsCount = 0;

      categorySections.forEach(section => {
        const sectionCategory = section.getAttribute('data-category');
        const cardsInSection = section.querySelectorAll('.feed-card');
        let visibleCardsInSectionCount = 0;

        cardsInSection.forEach(card => {
          const titleEl = card.querySelector('.feed-title');
          const title = titleEl ? titleEl.textContent.toLowerCase() : '';
          const links = Array.from(card.querySelectorAll('a')).map(a => a.href.toLowerCase()).join(' ');
          const textElement = card.querySelector('.fd-sub');
          const description = textElement ? textElement.textContent.toLowerCase() : '';

          const matchesSearch = title.includes(searchQuery) || description.includes(searchQuery) || links.includes(searchQuery);
          const matchesCategory = activeCategory === 'all' || sectionCategory === activeCategory;

          if (matchesSearch && matchesCategory) {
            card.style.display = 'grid';
            visibleCardsInSectionCount++;
            visibleFeedsCount++;
          } else {
            card.style.display = 'none';
          }
        });

        section.style.display = visibleCardsInSectionCount > 0 ? 'block' : 'none';
      });

      if (visibleFeedsCount === 0) {
        emptyState.classList.remove('hidden');
      } else {
        emptyState.classList.add('hidden');
      }
    }

    if (searchInput) {
      searchInput.addEventListener('input', (e) => {
        searchQuery = e.target.value.toLowerCase().trim();
        filterFeeds();
      });
    }

    categoryBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        categoryBtns.forEach(b => b.classList.remove('is-active'));
        btn.classList.add('is-active');
        activeCategory = btn.getAttribute('data-category');
        filterFeeds();
      });
    });
  });
</script>
