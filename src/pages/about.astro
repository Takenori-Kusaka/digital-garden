---
import BaseLayout from '../layouts/BaseLayout.astro';

const baseUrl = import.meta.env.BASE_URL;
const zennUrl = 'https://zenn.dev/takenori_kusaka/books/sovereign-resilience-blueprint';
const publishingHubUrl = 'https://github.com/Takenori-Kusaka/publishing-hub';

const values = [
  {
    t: '根拠を開示する',
    d: '判断の前提と、採用しなかった選択肢を明示する。結論だけを渡さない。'
  },
  {
    t: '相手の受容力から設計する',
    d: '最も進んだ手段ではなく、その現場が実際に使える手段を選ぶ。'
  },
  {
    t: '判断と責任の所在を明確にする',
    d: '提案はするが、決定は立場のある人が行える形に整える。'
  },
  {
    t: '持続可能な進め方を前提にする',
    d: '短期的な速度のために、運用と保守の負担を後ろへ送らない。'
  }
];

const fields = [
  {
    t: 'クラウドインフラ',
    d: 'AWSを中心としたクラウド基盤の設計・構築。IaCによる自動化と、セキュアで拡張性の高いアーキテクチャ。',
    tech: 'AWS, Terraform, CloudFormation, Serverless'
  },
  {
    t: '生成AI・LLM',
    d: '大規模言語モデルを業務へ組み込む設計。グループ全体の活用推進、社内DXコンサルティング10件以上、新規商品の企画と展示。',
    tech: 'Claude API, OpenAI API, Prompt Engineering, RAG'
  },
  {
    t: 'IoTシステム',
    d: '製造業向けIoTの設計・開発。エッジからクラウドまでの一貫した構築と、リアルタイムのデータ処理・可視化。',
    tech: 'MQTT, WebSocket, Time-series DB, Real-time Analytics'
  }
];
---

<BaseLayout
  title="About"
  description="日下武紀について。IoT・クラウド・生成AIエンジニア。現場と経営のあいだを翻訳する設計に取り組む。"
>
  <article class="ab">
    <header class="ab-hero">
      <p class="ab-eyebrow">About</p>
      <h1 class="ab-title">日下 武紀</h1>
      <p class="ab-en">Takenori Kusaka</p>
      <p class="ab-lead">
        IoT・クラウド・生成AIエンジニア。オムロンデジタル株式会社。
        舞鶴工業高等専門学校 情報工学科卒。
      </p>
    </header>

    <section class="ab-sec">
      <p class="ab-p">
        製造業向けIoTシステムの設計・開発、クラウドインフラの構築、
        生成AIを活用した業務実装に従事しています。
      </p>
      <p class="ab-p">
        高専ロボコンで全国大会に出場した経験から始まり、
        産業機械の組込み開発、小型無線機器の開発を経て、
        現在はクラウドを基盤としたIoT・AIシステムの設計と開発を行っています。
      </p>
    </section>

    <section class="ab-sec">
      <h2>仕事に臨む原則</h2>
      <dl class="ab-values">
        {values.map((v) => (
          <div>
            <dt>{v.t}</dt>
            <dd>{v.d}</dd>
          </div>
        ))}
      </dl>
    </section>

    <section class="ab-sec">
      <h2>専門分野</h2>
      <div class="ab-fields">
        {fields.map((f) => (
          <div class="ab-field">
            <h3>{f.t}</h3>
            <p>{f.d}</p>
            <p class="ab-tech">{f.tech}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="ab-sec">
      <h2>このサイトについて</h2>
      <p class="ab-p">
        公開プロフィールと、外部への入口です。
        気になることやまとめは
        <a href={publishingHubUrl} target="_blank" rel="noopener noreferrer">Publishing Hub</a>
        と
        <a href={zennUrl} target="_blank" rel="noopener noreferrer">Zenn</a>
        で発信しています。
      </p>
      <nav class="ab-links">
        <a href={`${baseUrl}/career/`}>キャリアビジョン</a>
        <a href={`${baseUrl}/resume/`}>職務経歴書</a>
        <a href={`${baseUrl}/feeds/`}>アンテナ</a>
      </nav>
    </section>

    <footer class="ab-foot">
      <p>本サイトは個人の見解であり、所属組織の公式見解ではありません。</p>
    </footer>
  </article>
</BaseLayout>

<style>
  .ab {
    --ink: var(--kb-color-text-primary);
    --slate: var(--kb-color-text-secondary);
    --line: var(--kb-color-border-line);
    --blue: var(--kb-color-text-link);
  }

  .ab-hero {
    padding: 0 0 2.5rem;
    border-bottom: 1px solid var(--line);
    margin-bottom: 3rem;
  }
  .ab-eyebrow {
    font-size: 0.74rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--slate);
    margin-bottom: 1rem;
  }
  .ab-title {
    font-size: 2rem;
    font-weight: 700;
    color: var(--ink);
    margin: 0 0 0.35rem;
    letter-spacing: 0.04em;
  }
  .ab-en {
    font-size: 0.85rem;
    letter-spacing: 0.12em;
    color: var(--slate);
    margin: 0 0 1.25rem;
  }
  .ab-lead {
    font-size: 1rem;
    line-height: 2;
    color: var(--kb-color-ink-800);
    max-width: 42rem;
  }

  .ab-sec {
    margin-bottom: 3.2rem;
  }
  .ab-sec h2 {
    font-size: 1.1rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--ink);
    border-bottom: 2px solid var(--ink);
    display: inline-block;
    padding-bottom: 0.5rem;
    margin-bottom: 1.25rem;
  }
  .ab-p {
    font-size: 0.95rem;
    line-height: 1.9;
    color: var(--kb-color-ink-800);
    max-width: 42rem;
    margin: 0 0 1rem;
  }
  .ab-p a {
    color: var(--blue);
    text-decoration: none;
    border-bottom: 1px solid var(--kb-color-ai-300);
  }
  .ab-p a:hover {
    border-bottom-color: var(--blue);
  }

  .ab-values {
    margin: 0;
  }
  .ab-values > div {
    display: grid;
    grid-template-columns: 16rem 1fr;
    gap: 1rem;
    padding: 0.8rem 0;
    border-bottom: 1px solid var(--line);
  }
  .ab-values > div:last-child {
    border-bottom: none;
  }
  .ab-values dt {
    font-size: 0.88rem;
    font-weight: 700;
    color: var(--ink);
  }
  .ab-values dd {
    margin: 0;
    font-size: 0.88rem;
    line-height: 1.8;
    color: var(--kb-color-ink-800);
  }

  .ab-fields {
    display: grid;
    gap: 1.25rem;
  }
  .ab-field {
    border-left: 3px solid var(--blue);
    padding-left: 1.2rem;
  }
  .ab-field h3 {
    font-size: 0.95rem;
    font-weight: 700;
    margin: 0 0 0.4rem;
    color: var(--ink);
  }
  .ab-field p {
    font-size: 0.88rem;
    line-height: 1.8;
    color: var(--kb-color-ink-800);
    margin: 0;
  }
  .ab-tech {
    font-size: 0.78rem;
    color: var(--slate);
    margin-top: 0.4rem !important;
  }

  .ab-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 1.5rem;
    margin-top: 1.25rem;
    font-size: 0.85rem;
  }
  .ab-links a {
    color: var(--blue);
    text-decoration: none;
    border-bottom: 1px solid var(--kb-color-ai-300);
    padding-bottom: 1px;
  }
  .ab-links a:hover {
    border-bottom-color: var(--blue);
  }

  .ab-foot {
    margin-top: 3.5rem;
    padding-top: 1.75rem;
    border-top: 1px solid var(--line);
    font-size: 0.82rem;
    line-height: 1.9;
    color: var(--slate);
  }

  @media (max-width: 720px) {
    .ab-values > div {
      grid-template-columns: 1fr;
      gap: 0.25rem;
    }
    .ab-title {
      font-size: 1.6rem;
    }
  }
</style>
