---
import fs from 'node:fs';
import { resolve } from 'node:path';
import { parse } from 'yaml';
import BaseLayout from '../layouts/BaseLayout.astro';
import rawProfile from '../data/profile.public.yml?raw';

const baseUrl = import.meta.env.BASE_URL;
const profile = parse(rawProfile);

// 提出用PDFが存在するときだけダウンロード導線を出す
const pdfExists = fs.existsSync(resolve(process.cwd(), 'public/resume.pdf'));

// 満年齢を生年月日から算出
function ageFrom(dateStr: string, now = new Date()): number {
  const [y, m, d] = dateStr.split('-').map(Number);
  let age = now.getFullYear() - y;
  const beforeBirthday =
    now.getMonth() + 1 < m || (now.getMonth() + 1 === m && now.getDate() < d);
  if (beforeBirthday) age -= 1;
  return age;
}
const age = ageFrom(profile.basics.birth_date);

const updated = profile.meta.updated;

// 空行を除いて段落配列にする
const paragraphs = (text: string): string[] =>
  text
    .split('\n')
    .map((line) => line.trim())
    .filter((line) => line.length > 0);
---

<BaseLayout
  title="職務経歴書"
  description="日下武紀の職務経歴書。IoT・クラウド・生成AIエンジニアとしての職務要約、職務経歴、技術、保有資格。"
>
  <article class="rs">
    <div class="rs-toolbar">
      {pdfExists ? (
        <a
          class="rs-dl"
          href={`${baseUrl}/resume.pdf`}
          download={`職務経歴書_日下武紀_${updated.replaceAll('-', '')}.pdf`}
        >
          職務経歴書 PDFをダウンロード
        </a>
      ) : (
        <span class="rs-dl rs-dl--pending">職務経歴書 PDF（ビルド時に生成）</span>
      )}
      <span class="rs-toolbar__meta">更新日：{updated}</span>
    </div>

    <header class="rs-head">
      <h1 class="rs-doc-title">職務経歴書</h1>
      <div class="rs-head__meta">
        <p class="rs-name">{profile.basics.name}<span class="rs-kana">（{profile.basics.name_kana}）</span></p>
        <p class="rs-updated">作成日：{updated}</p>
      </div>
    </header>

    <section class="rs-sec">
      <h2>職務要約</h2>
      {paragraphs(profile.summary).map((line) => <p class="rs-p">{line}</p>)}
    </section>

    <section class="rs-sec">
      <h2>基本情報</h2>
      <dl class="rs-basic">
        <div><dt>氏名</dt><dd>{profile.basics.name}（{profile.basics.name_kana}）</dd></div>
        <div><dt>生年月日</dt><dd>{profile.basics.birth_date.replaceAll('-', '年').replace(/(\d+)$/, '$1日')}（満{age}歳）</dd></div>
        <div><dt>職種</dt><dd>{profile.basics.title}</dd></div>
        <div><dt>最終学歴</dt><dd>{profile.education.school} {profile.education.department} {profile.education.graduated}</dd></div>
      </dl>
    </section>

    <section class="rs-sec">
      <h2>活かせる経験・知識・技術</h2>
      <table class="rs-table">
        <thead>
          <tr><th>技術・領域</th><th>経験</th><th>利用場面・担当工程</th><th>関与</th></tr>
        </thead>
        <tbody>
          {profile.skills.map((s) => (
            <tr>
              <td>{s.name}</td>
              <td>{s.years}</td>
              <td>{s.usage}</td>
              <td>{s.level}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </section>

    <section class="rs-sec">
      <h2>職務経歴</h2>
      {profile.history.map((company) => (
        <div class="rs-company">
          <div class="rs-company__head">
            <h3>{company.company}</h3>
            <span class="rs-company__period">{company.from} 〜 {company.to}</span>
          </div>
          <div class="rs-company__meta">
            <p><span class="k">職種</span>{company.role}<span class="d">／</span><span class="k">事業内容</span>{company.business}</p>
            {company.note && <p><span class="k">備考</span>{company.note}</p>}
          </div>
          {company.projects.map((p) => (
            <div class="rs-project">
              <div class="rs-project__head">
                <h4>{p.name}</h4>
                <span class="rs-project__period">{p.period}</span>
              </div>
              <p class="rs-project__meta">
                <span class="k">役割</span>{p.role}<span class="d">／</span><span class="k">規模</span>{p.team}<span class="d">／</span><span class="k">技術</span>{p.tech}<span class="d">／</span><span class="k">意思決定範囲</span>{p.scope}
              </p>
              <p class="rs-project__body">{p.body.trim().replace(/\n+/g, '')}</p>
            </div>
          ))}
        </div>
      ))}
    </section>

    <section class="rs-sec">
      <h2>保有資格</h2>
      <ul class="rs-list">
        {profile.certs.map((c) => (
          <li>
            {c.name}
            {c.issuer ? `（${c.issuer}）` : ''}
            {c.year ? ` ${c.year}` : ''}
            {c.note ? `（${c.note}）` : ''}
          </li>
        ))}
      </ul>
    </section>

    <section class="rs-sec">
      <h2>外部アウトプット</h2>
      <ul class="rs-list">
        {profile.output.map((o) => (
          <li>
            <a href={o.href} target="_blank" rel="noopener noreferrer">{o.label}</a>
          </li>
        ))}
      </ul>
    </section>

    <section class="rs-sec">
      <h2>自己PR</h2>
      {paragraphs(profile.pr).map((line) => <p class="rs-p">{line}</p>)}
    </section>

    <p class="rs-end">以上</p>

    <footer class="rs-foot">
      <p>本職務経歴書は個人の職務上の関心と実績を示すものであり、所属組織の公式見解ではありません。</p>
      <p class="rs-foot__note">
        内容は <a href={`${baseUrl}/career/`}>キャリアビジョン</a> および
        <a href="https://github.com/Takenori-Kusaka" target="_blank" rel="noopener noreferrer">GitHub</a>
        と整合させています。
      </p>
    </footer>
  </article>
</BaseLayout>

<style>
  .rs {
    --ink: var(--kb-color-text-primary);
    --slate: var(--kb-color-text-secondary);
    --line: var(--kb-color-border-line);
    --blue: var(--kb-color-text-link);
    max-width: 48rem;
    margin: 0 auto;
  }

  .rs-toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    padding-bottom: 1.1rem;
    margin-bottom: 2rem;
    border-bottom: 1px solid var(--line);
  }
  .rs-dl {
    font-size: 0.85rem;
    font-weight: 700;
    color: #fff;
    background: var(--blue);
    text-decoration: none;
    padding: 0.5rem 0.95rem;
    border: 1px solid var(--blue);
  }
  .rs-dl:hover {
    background: var(--kb-color-ai-800);
  }
  .rs-dl--pending {
    background: transparent;
    color: var(--slate);
    border-color: var(--line);
    font-weight: 400;
  }
  .rs-toolbar__meta {
    font-size: 0.78rem;
    color: var(--slate);
  }

  .rs-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 2.5rem;
    padding-bottom: 1.25rem;
    border-bottom: 2px solid var(--ink);
  }
  .rs-doc-title {
    font-size: 1.7rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    color: var(--ink);
    margin: 0;
  }
  .rs-head__meta {
    text-align: right;
  }
  .rs-name {
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--ink);
    margin: 0 0 0.25rem;
  }
  .rs-kana {
    font-size: 0.78rem;
    font-weight: 400;
    color: var(--slate);
  }
  .rs-updated {
    font-size: 0.78rem;
    color: var(--slate);
    margin: 0;
  }

  .rs-sec {
    margin-bottom: 2.6rem;
  }
  .rs-sec h2 {
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: var(--ink);
    background: var(--paper);
    border-left: 4px solid var(--blue);
    padding: 0.45rem 0.75rem;
    margin-bottom: 1.1rem;
  }
  .rs-p {
    font-size: 0.92rem;
    line-height: 1.95;
    color: var(--kb-color-ink-800);
    margin: 0 0 0.5rem;
  }

  .rs-basic {
    margin: 0;
  }
  .rs-basic > div {
    display: grid;
    grid-template-columns: 8rem 1fr;
    gap: 1rem;
    padding: 0.55rem 0;
    border-bottom: 1px solid var(--line);
  }
  .rs-basic > div:last-child {
    border-bottom: none;
  }
  .rs-basic dt {
    font-size: 0.85rem;
    color: var(--slate);
  }
  .rs-basic dd {
    margin: 0;
    font-size: 0.9rem;
    color: var(--kb-color-ink-800);
  }

  .rs-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.85rem;
  }
  .rs-table th,
  .rs-table td {
    text-align: left;
    vertical-align: top;
    padding: 0.55rem 0.7rem;
    border: 1px solid var(--line);
    line-height: 1.7;
  }
  .rs-table th {
    background: var(--paper);
    color: var(--ink);
    font-weight: 700;
    white-space: nowrap;
  }
  .rs-table td {
    color: var(--kb-color-ink-800);
  }

  .rs-company {
    margin-bottom: 1.8rem;
  }
  .rs-company__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    border-bottom: 1px solid var(--ink);
    padding-bottom: 0.4rem;
    margin-bottom: 0.8rem;
  }
  .rs-company__head h3 {
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--ink);
    margin: 0;
  }
  .rs-company__period {
    font-size: 0.8rem;
    color: var(--slate);
    white-space: nowrap;
  }
  .rs-company__meta,
  .rs-project__meta {
    margin: 0 0 0.7rem;
  }
  .rs-company__meta p,
  .rs-project__meta {
    font-size: 0.83rem;
    line-height: 1.8;
    color: var(--kb-color-ink-800);
    margin: 0 0 0.2rem;
  }
  .rs-company__meta .k,
  .rs-project__meta .k {
    font-size: 0.72rem;
    color: var(--slate);
    margin-right: 0.35rem;
    margin-left: 0.1rem;
    white-space: nowrap;
  }
  .rs-company__meta .k:first-child,
  .rs-project__meta .k:first-child {
    margin-left: 0;
  }
  .rs-company__meta .d,
  .rs-project__meta .d {
    color: var(--line);
    margin: 0 0.6rem;
  }

  .rs-project {
    padding-left: 1rem;
    border-left: 2px solid var(--line);
    margin-bottom: 1.6rem;
    break-inside: avoid;
  }
  .rs-project__head {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-bottom: 0.6rem;
  }
  .rs-project__head h4 {
    font-size: 0.92rem;
    font-weight: 700;
    color: var(--ink);
    margin: 0;
  }
  .rs-project__period {
    font-size: 0.75rem;
    color: var(--slate);
    white-space: nowrap;
  }
  .rs-project__body {
    font-size: 0.85rem;
    line-height: 1.9;
    color: var(--kb-color-ink-800);
    margin: 0;
  }

  .rs-list {
    margin: 0;
    padding-left: 1.2rem;
  }
  .rs-list li {
    font-size: 0.88rem;
    line-height: 1.9;
    color: var(--kb-color-ink-800);
    margin-bottom: 0.3rem;
  }
  .rs-list a {
    color: var(--blue);
    text-decoration: none;
    border-bottom: 1px solid var(--kb-color-ai-300);
  }
  .rs-list a:hover {
    border-bottom-color: var(--blue);
  }

  .rs-end {
    text-align: right;
    font-size: 0.85rem;
    color: var(--slate);
    margin: 2.5rem 0 0;
  }

  .rs-foot {
    margin-top: 2.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
    font-size: 0.78rem;
    line-height: 1.9;
    color: var(--slate);
  }
  .rs-foot__note a {
    color: var(--blue);
    text-decoration: none;
    border-bottom: 1px solid var(--kb-color-ai-300);
  }

  @media (max-width: 720px) {
    .rs-basic > div,
    .rs-company__meta > div,
    .rs-project__meta > div {
      grid-template-columns: 1fr;
      gap: 0.15rem;
    }
    .rs-head {
      flex-direction: column;
      align-items: flex-start;
    }
    .rs-head__meta {
      text-align: left;
    }
    .rs-doc-title {
      font-size: 1.4rem;
    }
  }

  @media print {
    .rs-toolbar {
      display: none;
    }
    .rs {
      max-width: none;
      font-size: 10pt;
    }
    .rs-sec {
      margin-bottom: 1.1rem;
    }
    .rs-sec h2 {
      font-size: 9.5pt;
      padding: 0.25rem 0.5rem;
      margin-bottom: 0.5rem;
      break-after: avoid;
    }
    .rs-p,
    .rs-company__meta p,
    .rs-project__meta {
      font-size: 8.6pt;
      line-height: 1.55;
    }
    .rs-basic > div {
      padding: 0.2rem 0;
    }
    .rs-table {
      font-size: 8.4pt;
    }
    .rs-table th,
    .rs-table td {
      padding: 0.25rem 0.4rem;
      line-height: 1.45;
    }
    .rs-company {
      margin-bottom: 0.9rem;
      break-inside: auto;
    }
    .rs-company__head {
      margin-bottom: 0.4rem;
      padding-bottom: 0.2rem;
      break-after: avoid;
    }
    .rs-project {
      padding-left: 0.7rem;
      margin-bottom: 0.7rem;
      break-inside: avoid;
    }
    .rs-project__head {
      margin-bottom: 0.25rem;
      break-after: avoid;
    }
    .rs-list li {
      font-size: 8.6pt;
      line-height: 1.6;
      margin-bottom: 0.1rem;
    }
    .rs-end,
    .rs-foot {
      font-size: 8pt;
    }
  }
</style>
