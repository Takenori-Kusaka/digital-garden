---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = '日下武紀の公開プロフィール。IoT・クラウド・生成AIの設計と、現場と経営のあいだの翻訳。'
} = Astro.props;

const baseUrl = import.meta.env.BASE_URL;
const siteUrl = import.meta.env.SITE || 'https://takenori-kusaka.github.io';
const fullUrl = `${siteUrl}${baseUrl}`;

const nav = [
  { href: `${baseUrl}/about/`, label: 'About' },
  { href: `${baseUrl}/career/`, label: 'Career' },
  { href: `${baseUrl}/resume/`, label: 'Resume' },
  { href: `${baseUrl}/feeds/`, label: 'Antenna' }
];

const currentPath = Astro.url.pathname;
---

<!DOCTYPE html>
<html lang="ja" data-theme="light">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content={description}>
  <meta name="generator" content={Astro.generator}>
  <meta name="author" content="日下武紀 (Takenori Kusaka)">

  <!-- Favicon -->
  <link rel="icon" type="image/png" sizes="512x512" href={`${baseUrl}/favicon.png`}>
  <link rel="apple-touch-icon" href={`${baseUrl}/favicon.png`}>

  <!-- Open Graph / Facebook -->
  <meta property="og:type" content="website">
  <meta property="og:url" content={fullUrl}>
  <meta property="og:title" content={`${title} | 日下武紀`}>
  <meta property="og:description" content={description}>
  <meta property="og:image" content={`${siteUrl}${baseUrl}/og-image.png`}>
  <meta property="og:site_name" content="日下武紀">
  <meta property="og:locale" content="ja_JP">

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:url" content={fullUrl}>
  <meta name="twitter:title" content={`${title} | 日下武紀`}>
  <meta name="twitter:description" content={description}>
  <meta name="twitter:image" content={`${siteUrl}${baseUrl}/og-image.png`}>

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=BIZ+UDPGothic:wght@400;700&family=Noto+Sans+JP:wght@400;500;700&display=swap" rel="stylesheet">

  <title>{title} | 日下武紀</title>
</head>
<body class="site">
  <header class="site-header">
    <div class="site-header__inner">
      <a href={baseUrl} class="site-brand">
        <span class="site-brand__name">日下 武紀</span>
        <span class="site-brand__sub">Takenori Kusaka</span>
      </a>
      <nav class="site-nav">
        {nav.map((item) => (
          <a
            href={item.href}
            class:list={['site-nav__link', { 'is-active': currentPath.startsWith(item.href) }]}
          >
            {item.label}
          </a>
        ))}
      </nav>
    </div>
  </header>

  <main class="site-main">
    <slot />
  </main>

  <footer class="site-footer">
    <div class="site-footer__inner">
      <p class="site-footer__note">
        &copy; 2026 日下武紀 (Takenori Kusaka)
      </p>
      <nav class="site-footer__links">
        <a href="https://github.com/Takenori-Kusaka" target="_blank" rel="noopener noreferrer">GitHub</a>
        <a href="https://zenn.dev/takenori_kusaka" target="_blank" rel="noopener noreferrer">Zenn</a>
        <a href="https://github.com/Takenori-Kusaka/publishing-hub" target="_blank" rel="noopener noreferrer">Publishing Hub</a>
        <a href="https://www.linkedin.com/in/%E6%AD%A6%E7%B4%80-%E6%97%A5%E4%B8%8B-17947820a/" target="_blank" rel="noopener noreferrer">LinkedIn</a>
        <a href="https://www.youtube.com/channel/UCD1zo-WnyFdE5w0pqvKblkA" target="_blank" rel="noopener noreferrer">YouTube</a>
        <a href="https://listen.style/p/recalog" target="_blank" rel="noopener noreferrer">Podcast</a>
      </nav>
    </div>
  </footer>
</body>
</html>

<style is:global>
  .site {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    background: var(--kb-color-surface-page);
    color: var(--ink);
    font-family: 'Noto Sans JP', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    -webkit-font-smoothing: antialiased;
  }

  /* Header */
  .site-header {
    border-bottom: 1px solid var(--line);
    background: var(--kb-color-surface-card);
  }
  .site-header__inner {
    max-width: 56rem;
    margin: 0 auto;
    padding: 1.25rem 1.5rem;
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1.5rem;
    flex-wrap: wrap;
  }
  .site-brand {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    text-decoration: none;
  }
  .site-brand__name {
    font-size: 1.05rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    color: var(--ink);
  }
  .site-brand__sub {
    font-size: 0.68rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--slate);
  }
  .site-nav {
    display: flex;
    gap: 1.6rem;
    flex-wrap: wrap;
  }
  .site-nav__link {
    font-size: 0.85rem;
    letter-spacing: 0.04em;
    color: var(--slate);
    text-decoration: none;
    padding-bottom: 2px;
    border-bottom: 1px solid transparent;
    transition: color 0.15s ease, border-color 0.15s ease;
  }
  .site-nav__link:hover {
    color: var(--blue);
    border-bottom-color: var(--kb-color-ai-300);
  }
  .site-nav__link.is-active {
    color: var(--ink);
    border-bottom-color: var(--ink);
  }

  /* Main */
  .site-main {
    flex: 1;
    max-width: 56rem;
    margin: 0 auto;
    padding: 3rem 1.5rem 4rem;
    width: 100%;
  }

  /* Footer */
  .site-footer {
    border-top: 1px solid var(--line);
    background: var(--paper);
  }
  .site-footer__inner {
    max-width: 56rem;
    margin: 0 auto;
    padding: 2rem 1.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .site-footer__note {
    font-size: 0.78rem;
    color: var(--slate);
    margin: 0;
  }
  .site-footer__links {
    display: flex;
    gap: 1.25rem;
    flex-wrap: wrap;
  }
  .site-footer__links a {
    font-size: 0.78rem;
    color: var(--slate);
    text-decoration: none;
  }
  .site-footer__links a:hover {
    color: var(--blue);
    text-decoration: underline;
  }

  @media (max-width: 640px) {
    .site-header__inner {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.9rem;
    }
    .site-main {
      padding: 2rem 1.25rem 3rem;
    }
  }

  /* Print: strip the shell so the page content prints clean (resume) */
  @media print {
    .site-header,
    .site-footer {
      display: none;
    }
    .site-main {
      max-width: none;
      padding: 0;
    }
  }
</style>
